rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Organizer admin can read all
      allow read: if request.auth.token.admin == true;
    }

    // Workers can read/write their own profile
    match /workers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Anyone logged in can read available workers (for matching)
      allow read: if request.auth != null;
      // Organizer admin can update any worker (for KYC approval)
      allow update: if request.auth.token.admin == true;
    }

    // Bookings: user or assigned worker can read/write
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.workerId == request.auth.uid);
      allow create: if request.auth != null;
      // Organizer can read all bookings
      allow read: if request.auth.token.admin == true;
    }

    // Assessments: worker reads their own, organizer manages
    match /assessments/{assessmentId} {
      allow read: if request.auth != null &&
        resource.data.workerId == request.auth.uid;
      allow read, write: if request.auth.token.admin == true;
    }

    // Complaints: user creates, organizer manages
    match /complaints/{complaintId} {
      allow create: if request.auth != null;
      allow read, write: if request.auth.token.admin == true;
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
  }
}
