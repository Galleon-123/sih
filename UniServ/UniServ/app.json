{
  "expo": {
    "name": "UniServ",
    "slug": "uniserv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniserv.user",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "UniServ needs your location to find nearby workers.",
        "NSLocationAlwaysUsageDescription": "UniServ needs your location to track worker arrival."
      }
    },
    "android": {
      "package": "com.uniserv.user",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "UniServ needs your location to find nearby workers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UniServ needs photo access for uploading service images.",
          "cameraPermission": "UniServ needs camera access for service photos."
        }
      ]
    ]
  }
}
